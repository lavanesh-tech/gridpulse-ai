# Copy to .env (never commit .env)
POSTGRES_DB=gridpulse
POSTGRES_USER=gridpulse
POSTGRES_PASSWORD=change-me-locally
POSTGRES_PORT=5433
REDIS_PORT=6380
# >= 32 random bytes, e.g. `openssl rand -base64 48`
GRIDPULSE_JWT_SECRET=replace-with-output-of-openssl-rand-base64-48
# Optional: creates a demo tenant + admin on first start
GRIDPULSE_ADMIN_PASSWORD=
