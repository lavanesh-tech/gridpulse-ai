# Copy to .env (never commit .env)
POSTGRES_DB=gridpulse
POSTGRES_USER=gridpulse
POSTGRES_PASSWORD=change-me-locally
POSTGRES_PORT=5433
REDIS_PORT=6380
# >= 32 random bytes, e.g. `openssl rand -base64 48`
GRIDPULSE_JWT_SECRET=replace-with-output-of-openssl-rand-base64-48
# Optional: creates a demo tenant + admin on first start
GRIDPULSE_ADMIN_PASSWORD=
# --- AI Energy Advisor (optional). Without these the advisor still retrieves documents but gives no AI answers. ---
# Put the real key only in .env (git-ignored). Set a spending limit on your OpenAI account.
OPENAI_API_KEY=
SPRING_AI_MODEL_CHAT=none
SPRING_AI_MODEL_EMBEDDING=none
